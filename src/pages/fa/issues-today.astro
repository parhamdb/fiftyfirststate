---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/HeroSection.astro';
import StatCard from '../../components/StatCard.astro';
---
<BaseLayout title="مسائل امروز" lang="fa">

  <HeroSection
    headline="بحران‌های ایران"
    subtitle="آمار دروغ نمی‌گوید"
    lang="fa"
  />

  <!-- 1. بحران اقتصادی -->
  <section class="max-w-7xl mx-auto px-6 py-16 md:py-24">
    <h2 class="text-3xl font-bold text-navy mb-12 text-center">بحران اقتصادی</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
      <StatCard
        number="٪۴۸"
        unit="تورم"
        description="هر روز همه چیز گران‌تر می‌شود."
        variant="navy"
      />
      <StatCard
        number="۲۰,۰۰۰×"
        unit="سقوط ارزش ریال"
        description="پول ایران در ۴۰ سال ۲۰ هزار برابر بی‌ارزش شده."
        variant="white"
      />
      <StatCard
        number="٪۳۸.۸"
        unit="زیر خط فقر"
        description="از هر ۳ ایرانی، بیش از ۱ نفر زیر خط فقر زندگی می‌کند."
        variant="navy"
      />
    </div>
    <div class="prose prose-lg max-w-none text-gray-700">
      <p>
        تحریم‌ها اقتصاد را فلج کرده. فرار مغزها هر سال ۵۰ تا ۷۰ میلیارد دلار ضرر می‌زند. ۸۰٪ دانشجوهای پزشکی می‌خواهند بروند. هیچ سرمایه‌گذار خارجی نمی‌آید و تورم هر روز زندگی را سخت‌تر می‌کند.
      </p>
    </div>
  </section>

  <!-- 2. حقوق بشر -->
  <section class="bg-gray-bg py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-6">
      <h2 class="text-3xl font-bold text-navy mb-12 text-center">حقوق بشر</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
        <StatCard
          number="+۲,۲۲۸"
          unit="اعدام در ۲۰۲۵"
          description="بیشترین نرخ اعدام سرانه در جهان."
          variant="navy"
        />
        <StatCard
          number="+۷,۰۰۰"
          unit="کشته در اعتراضات ژانویه ۲۰۲۶"
          description="نیروهای امنیتی مردم را به گلوله بستند."
          variant="navy"
        />
      </div>
      <div class="prose prose-lg max-w-none text-gray-700">
        <p>
          هزاران زندانی سیاسی پشت میله‌ها هستند. اعتراض کنی، گلوله می‌خوری. شکنجه و اعتراف اجباری عادی شده. دادگاه انقلاب بدون وکیل و بدون هیئت منصفه حکم می‌دهد.
        </p>
      </div>
    </div>
  </section>

  <!-- 3. حقوق زنان -->
  <section class="max-w-7xl mx-auto px-6 py-16 md:py-24">
    <h2 class="text-3xl font-bold text-navy mb-12 text-center">حقوق زنان</h2>
    <div class="prose prose-lg max-w-none text-gray-700">
      <p>
        شهادت زن نصف مرد ارزش دارد. ارث زن نصف مرد است. بی‌حجابی تا ۱۵ سال زندان دارد. دختر ۱۳ ساله می‌تواند شوهر داده شود. زن بدون اجازه شوهر نمی‌تواند از کشور خارج شود. طلاق فقط دست مرد است.
      </p>
      <p>
        اینها تبعیض تصادفی نیست — در قانون نوشته شده و دادگاه‌ها اجرایش می‌کنند.
      </p>
    </div>
  </section>

  <!-- 4. آزادی مذهب -->
  <section class="bg-gray-bg py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-6">
      <h2 class="text-3xl font-bold text-navy mb-12 text-center">آزادی مذهب</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-right border-collapse">
          <thead>
            <tr class="border-b-2 border-navy">
              <th class="py-4 px-6 text-navy font-bold text-lg">گروه</th>
              <th class="py-4 px-6 text-navy font-bold text-lg">جمعیت تخمینی</th>
              <th class="py-4 px-6 text-navy font-bold text-lg">وضعیت</th>
            </tr>
          </thead>
          <tbody class="text-gray-700">
            <tr class="border-b border-gray-200">
              <td class="py-4 px-6 font-bold">بهائیان</td>
              <td class="py-4 px-6">۳۰۰,۰۰۰</td>
              <td class="py-4 px-6">حق دانشگاه رفتن ندارند، اموالشان مصادره می‌شود، زندانی می‌شوند</td>
            </tr>
            <tr class="border-b border-gray-200">
              <td class="py-4 px-6 font-bold">مسیحیان</td>
              <td class="py-4 px-6">۳۰۰,۰۰۰ — ۵۰۰,۰۰۰</td>
              <td class="py-4 px-6">بازداشت، کلیساها بسته شده، تبلیغ دین ممنوع</td>
            </tr>
            <tr class="border-b border-gray-200">
              <td class="py-4 px-6 font-bold">سنی‌ها</td>
              <td class="py-4 px-6">۵ — ۱۰ میلیون</td>
              <td class="py-4 px-6">در تهران با ۹ میلیون جمعیت حتی یک مسجد سنی نیست</td>
            </tr>
            <tr>
              <td class="py-4 px-6 font-bold">زرتشتیان</td>
              <td class="py-4 px-6">۲۵,۰۰۰</td>
              <td class="py-4 px-6">تبعیض شغلی و اجتماعی</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 5. اقلیت‌های قومی -->
  <section class="max-w-7xl mx-auto px-6 py-16 md:py-24">
    <h2 class="text-3xl font-bold text-navy mb-12 text-center">اقلیت‌های قومی</h2>
    <div class="prose prose-lg max-w-none text-gray-700">
      <p>
        ۹۷٪ اعدام‌های سیاسی کُردها، بلوچ‌ها و عرب‌ها هستند. بعد از اعتراضات ژوئن ۲۰۲۵، بیش از ۲۱ هزار نفر دستگیر شدند. قانون اساسی خود ایران حق تدریس به زبان مادری را داده — ولی هرگز اجرا نشده.
      </p>
      <p>
        کردی، ترکی آذری، بلوچی و عربی در مدارس ممنوع است. فعالان اقلیت‌ها را به جرم «محاربه» اعدام می‌کنند.
      </p>
    </div>
  </section>

  <!-- 6. فساد -->
  <section class="bg-gray-bg py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-6">
      <h2 class="text-3xl font-bold text-navy mb-12 text-center">فساد</h2>
      <div class="prose prose-lg max-w-none text-gray-700">
        <ul class="space-y-4 list-none pr-0">
          <li class="flex items-start gap-3">
            <span class="text-gold text-xl mt-0.5 flex-shrink-0">&#9679;</span>
            <span>سپاه بیش از ۸۰٪ دارایی‌های «خصوصی‌سازی» شده را برداشته.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-gold text-xl mt-0.5 flex-shrink-0">&#9679;</span>
            <span>دفتر خامنه‌ای ۹۵ میلیارد دلار دارایی داشت.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-gold text-xl mt-0.5 flex-shrink-0">&#9679;</span>
            <span>رتبه شفافیت: ۱۵۱ از ۱۸۰ کشور</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 7. محیط زیست -->
  <section class="max-w-7xl mx-auto px-6 py-16 md:py-24">
    <h2 class="text-3xl font-bold text-navy mb-12 text-center">محیط زیست</h2>
    <div class="prose prose-lg max-w-none text-gray-700">
      <ul class="space-y-4 list-none pr-0">
        <li class="flex items-start gap-3">
          <span class="text-gold text-xl mt-0.5 flex-shrink-0">&#9679;</span>
          <span>دریاچه ارومیه ۹۵٪ خشک شده است.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-gold text-xl mt-0.5 flex-shrink-0">&#9679;</span>
          <span>تهران آلوده‌ترین شهر جهان</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-gold text-xl mt-0.5 flex-shrink-0">&#9679;</span>
          <span>بیش از ۴۰ شهر آب جیره‌بندی شده.</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- CTA: راه حل وجود دارد -->
  <section class="bg-navy py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <p class="text-3xl font-bold text-white mb-6">یک راه‌حل هست.</p>
      <a
        href="/fa/your-rights/"
        class="inline-block bg-gold text-navy font-bold text-lg px-8 py-4 rounded-lg hover:bg-gold-light transition-colors"
      >
        حقوق شما تحت قانون اساسی آمریکا
      </a>
    </div>
  </section>

</BaseLayout>
