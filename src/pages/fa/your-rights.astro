---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/HeroSection.astro';
---
<BaseLayout title="حقوق شما" lang="fa">

  <HeroSection
    headline="حقوق شما تحت قانون اساسی آمریکا"
    subtitle="این حقوق ۲۵۰ سال است که اثبات شده — برای همه و بدون استثنا."
    lang="fa"
  />

  <!-- Rights Comparison Cards -->
  <section class="max-w-7xl mx-auto px-6 py-20 md:py-28">

    <!-- 1. آزادی بیان -->
    <div class="mb-14">
      <h2 class="text-2xl md:text-3xl font-black text-navy mb-6 text-center">آزادی بیان</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-0 rounded-2xl overflow-hidden shadow-lg">
        <div class="bg-gradient-to-br from-red-900 to-red-950 text-white p-8 md:p-10">
          <h3 class="text-lg font-black mb-1 text-red-300">جمهوری اسلامی</h3>
          <ul class="space-y-3 mt-4 text-red-100">
            <li>رتبه آزادی مطبوعات: ۱۷۶ از ۱۸۰</li>
            <li>روزنامه‌نگاران زندانی</li>
            <li>شبکه‌های اجتماعی مسدود</li>
          </ul>
        </div>
        <div class="bg-gradient-to-br from-green-800 to-green-900 text-white p-8 md:p-10">
          <h3 class="text-lg font-black mb-1 text-gold-light">قانون اساسی آمریکا</h3>
          <ul class="space-y-3 mt-4 text-green-100">
            <li>متمم اول قانون اساسی</li>
            <li>هر چه می‌خواهید بگویید. هر چه می‌خواهید منتشر کنید.</li>
            <li>دولت حق سانسور ندارد.</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- 2. آزادی مذهب -->
    <div class="mb-14">
      <h2 class="text-2xl md:text-3xl font-black text-navy mb-6 text-center">آزادی مذهب</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-0 rounded-2xl overflow-hidden shadow-lg">
        <div class="bg-gradient-to-br from-red-900 to-red-950 text-white p-8 md:p-10">
          <h3 class="text-lg font-black mb-1 text-red-300">جمهوری اسلامی</h3>
          <ul class="space-y-3 mt-4 text-red-100">
            <li>ارتداد = اعدام</li>
            <li>بهائیان از ورود به دانشگاه محروم</li>
            <li>هیچ مسجد سنی در تهران (۹+ میلیون نفر)</li>
          </ul>
        </div>
        <div class="bg-gradient-to-br from-green-800 to-green-900 text-white p-8 md:p-10">
          <h3 class="text-lg font-black mb-1 text-gold-light">قانون اساسی آمریکا</h3>
          <ul class="space-y-3 mt-4 text-green-100">
            <li>متمم اول قانون اساسی</li>
            <li>هر دینی که بخواهید داشته باشید — یا هیچ‌کدام.</li>
            <li>دین رسمی وجود ندارد. دین و دولت از هم جدا هستند.</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- 3. حقوق زنان -->
    <div class="mb-14">
      <h2 class="text-2xl md:text-3xl font-black text-navy mb-6 text-center">حقوق زنان</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-0 rounded-2xl overflow-hidden shadow-lg">
        <div class="bg-gradient-to-br from-red-900 to-red-950 text-white p-8 md:p-10">
          <h3 class="text-lg font-black mb-1 text-red-300">جمهوری اسلامی</h3>
          <ul class="space-y-3 mt-4 text-red-100">
            <li>شهادت زن = نصف مرد</li>
            <li>ارث زن = نصف مرد</li>
            <li>حجاب اجباری (تا ۱۵ سال زندان)</li>
            <li>سن ازدواج: ۱۳ سال</li>
          </ul>
        </div>
        <div class="bg-gradient-to-br from-green-800 to-green-900 text-white p-8 md:p-10">
          <h3 class="text-lg font-black mb-1 text-gold-light">قانون اساسی آمریکا</h3>
          <ul class="space-y-3 mt-4 text-green-100">
            <li>زن و مرد در برابر قانون برابرند</li>
            <li>هیچ الزامی برای پوشش وجود ندارد</li>
            <li>شهادت برابر، ارث برابر</li>
            <li>هیچ‌کس حق ندارد پوشش شما را تعیین کند</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- 4. حقوق اقلیت‌ها -->
    <div class="mb-14">
      <h2 class="text-2xl md:text-3xl font-black text-navy mb-6 text-center">حقوق اقلیت‌ها</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-0 rounded-2xl overflow-hidden shadow-lg">
        <div class="bg-gradient-to-br from-red-900 to-red-950 text-white p-8 md:p-10">
          <h3 class="text-lg font-black mb-1 text-red-300">جمهوری اسلامی</h3>
          <ul class="space-y-3 mt-4 text-red-100">
            <li>۹۷٪ اعدام‌های سیاسی: کردها، بلوچ‌ها، عرب‌ها</li>
            <li>زبان‌های اقلیت سرکوب شده</li>
          </ul>
        </div>
        <div class="bg-gradient-to-br from-green-800 to-green-900 text-white p-8 md:p-10">
          <h3 class="text-lg font-black mb-1 text-gold-light">قانون اساسی آمریکا</h3>
          <ul class="space-y-3 mt-4 text-green-100">
            <li>همه در برابر قانون برابرند — فرقی نمی‌کند از کجا باشید</li>
            <li>زبان رسمی اجباری وجود ندارد. می‌توانید به زبان مادری خود تحصیل کنید.</li>
            <li>هر شهروندی می‌تواند نماینده، فرماندار یا رئیس‌جمهور شود.</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- 5. دادرسی عادلانه -->
    <div class="mb-14">
      <h2 class="text-2xl md:text-3xl font-black text-navy mb-6 text-center">دادرسی عادلانه</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-0 rounded-2xl overflow-hidden shadow-lg">
        <div class="bg-gradient-to-br from-red-900 to-red-950 text-white p-8 md:p-10">
          <h3 class="text-lg font-black mb-1 text-red-300">جمهوری اسلامی</h3>
          <ul class="space-y-3 mt-4 text-red-100">
            <li>دادگاه‌های انقلاب</li>
            <li>اعترافات اجباری</li>
            <li>بدون هیئت منصفه</li>
            <li>محاکمات مخفی</li>
          </ul>
        </div>
        <div class="bg-gradient-to-br from-green-800 to-green-900 text-white p-8 md:p-10">
          <h3 class="text-lg font-black mb-1 text-gold-light">قانون اساسی آمریکا</h3>
          <ul class="space-y-3 mt-4 text-green-100">
            <li>حق داشتن وکیل</li>
            <li>محاکمه با هیئت منصفه</li>
            <li>بدون حکم دادگاه کسی را نمی‌توانند بازداشت کنند</li>
            <li>تا زمانی که جرم ثابت نشده، بی‌گناه محسوب می‌شوید</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- 6. حقوق دیجیتال -->
    <div class="mb-14">
      <h2 class="text-2xl md:text-3xl font-black text-navy mb-6 text-center">حقوق دیجیتال</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-0 rounded-2xl overflow-hidden shadow-lg">
        <div class="bg-gradient-to-br from-red-900 to-red-950 text-white p-8 md:p-10">
          <h3 class="text-lg font-black mb-1 text-red-300">جمهوری اسلامی</h3>
          <ul class="space-y-3 mt-4 text-red-100">
            <li>امتیاز آزادی اینترنت: ۲ از ۱۰۰</li>
            <li>کلید قطع اینترنت</li>
            <li>وی‌پی‌ان غیرقانونی</li>
            <li>نظارت کامل</li>
          </ul>
        </div>
        <div class="bg-gradient-to-br from-green-800 to-green-900 text-white p-8 md:p-10">
          <h3 class="text-lg font-black mb-1 text-gold-light">قانون اساسی آمریکا</h3>
          <ul class="space-y-3 mt-4 text-green-100">
            <li>حریم خصوصی شما محفوظ است — کسی حق جاسوسی ندارد</li>
            <li>اینترنت آزاد و بدون فیلتر</li>
            <li>دولت حق سانسور ندارد</li>
          </ul>
        </div>
      </div>
    </div>

  </section>

  <!-- CTA -->
  <section class="bg-navy py-20 md:py-28">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <p class="text-2xl font-black text-white mb-8">این حقوق می‌تواند شامل حال شما هم شود.</p>
      <a
        href="/fa/issues-today/"
        class="inline-block bg-gold text-navy font-black text-lg px-10 py-5 rounded-xl hover:bg-gold-light transition-colors shadow-lg shadow-gold/20"
      >
        مسائل امروز ایران
      </a>
    </div>
  </section>

</BaseLayout>
