---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/HeroSection.astro';
---
<BaseLayout title="حقوق شما" lang="fa">

  <HeroSection
    headline="حقوق شما تحت قانون اساسی آمریکا"
    subtitle="این حقوق ۲۵۰ سال امتحان پس داده‌اند. برای همه — بدون استثنا."
    lang="fa"
  />

  <!-- Rights Comparison Cards -->
  <section class="max-w-7xl mx-auto px-6 py-16 md:py-24">

    <!-- 1. آزادی بیان -->
    <div class="mb-12">
      <h2 class="text-2xl md:text-3xl font-bold text-navy mb-6 text-center">آزادی بیان</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-0 rounded-xl overflow-hidden shadow-lg">
        <div class="bg-red-900 text-white p-8">
          <h3 class="text-lg font-bold mb-1 text-red-300">جمهوری اسلامی</h3>
          <ul class="space-y-3 mt-4 text-red-100">
            <li>رتبه آزادی مطبوعات: ۱۷۶ از ۱۸۰</li>
            <li>روزنامه‌نگاران زندانی</li>
            <li>شبکه‌های اجتماعی مسدود</li>
          </ul>
        </div>
        <div class="bg-green-800 text-white p-8">
          <h3 class="text-lg font-bold mb-1 text-gold-light">قانون اساسی آمریکا</h3>
          <ul class="space-y-3 mt-4 text-green-100">
            <li>متمم اول قانون اساسی</li>
            <li>هر چه می‌خواهی بگو. هر چه می‌خواهی منتشر کن.</li>
            <li>دولت حق سانسور ندارد.</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- 2. آزادی مذهب -->
    <div class="mb-12">
      <h2 class="text-2xl md:text-3xl font-bold text-navy mb-6 text-center">آزادی مذهب</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-0 rounded-xl overflow-hidden shadow-lg">
        <div class="bg-red-900 text-white p-8">
          <h3 class="text-lg font-bold mb-1 text-red-300">جمهوری اسلامی</h3>
          <ul class="space-y-3 mt-4 text-red-100">
            <li>ارتداد = اعدام</li>
            <li>بهائیان از ورود به دانشگاه محروم</li>
            <li>هیچ مسجد سنی در تهران (۹+ میلیون نفر)</li>
          </ul>
        </div>
        <div class="bg-green-800 text-white p-8">
          <h3 class="text-lg font-bold mb-1 text-gold-light">قانون اساسی آمریکا</h3>
          <ul class="space-y-3 mt-4 text-green-100">
            <li>متمم اول قانون اساسی</li>
            <li>هر دینی می‌خواهی داشته باش — یا هیچ‌کدام.</li>
            <li>دین رسمی وجود ندارد. دین و دولت از هم جدا هستند.</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- 3. حقوق زنان -->
    <div class="mb-12">
      <h2 class="text-2xl md:text-3xl font-bold text-navy mb-6 text-center">حقوق زنان</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-0 rounded-xl overflow-hidden shadow-lg">
        <div class="bg-red-900 text-white p-8">
          <h3 class="text-lg font-bold mb-1 text-red-300">جمهوری اسلامی</h3>
          <ul class="space-y-3 mt-4 text-red-100">
            <li>شهادت زن = نصف مرد</li>
            <li>ارث زن = نصف مرد</li>
            <li>حجاب اجباری (تا ۱۵ سال زندان)</li>
            <li>سن ازدواج: ۱۳ سال</li>
          </ul>
        </div>
        <div class="bg-green-800 text-white p-8">
          <h3 class="text-lg font-bold mb-1 text-gold-light">قانون اساسی آمریکا</h3>
          <ul class="space-y-3 mt-4 text-green-100">
            <li>زن و مرد در برابر قانون برابرند</li>
            <li>هیچ قانون پوششی وجود ندارد</li>
            <li>شهادت برابر، ارث برابر</li>
            <li>هیچ‌کس نمی‌تواند بگوید چه بپوشی</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- 4. حقوق اقلیت‌ها -->
    <div class="mb-12">
      <h2 class="text-2xl md:text-3xl font-bold text-navy mb-6 text-center">حقوق اقلیت‌ها</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-0 rounded-xl overflow-hidden shadow-lg">
        <div class="bg-red-900 text-white p-8">
          <h3 class="text-lg font-bold mb-1 text-red-300">جمهوری اسلامی</h3>
          <ul class="space-y-3 mt-4 text-red-100">
            <li>۹۷٪ اعدام‌های سیاسی: کردها، بلوچ‌ها، عرب‌ها</li>
            <li>زبان‌های اقلیت سرکوب شده</li>
          </ul>
        </div>
        <div class="bg-green-800 text-white p-8">
          <h3 class="text-lg font-bold mb-1 text-gold-light">قانون اساسی آمریکا</h3>
          <ul class="space-y-3 mt-4 text-green-100">
            <li>همه در برابر قانون برابرند — فرقی نمی‌کند از کجایی</li>
            <li>زبان رسمی وجود ندارد. به زبان مادری‌ات درس بخوان.</li>
            <li>هر شهروندی می‌تواند نماینده، فرماندار یا رئیس‌جمهور شود.</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- 5. دادرسی عادلانه -->
    <div class="mb-12">
      <h2 class="text-2xl md:text-3xl font-bold text-navy mb-6 text-center">دادرسی عادلانه</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-0 rounded-xl overflow-hidden shadow-lg">
        <div class="bg-red-900 text-white p-8">
          <h3 class="text-lg font-bold mb-1 text-red-300">جمهوری اسلامی</h3>
          <ul class="space-y-3 mt-4 text-red-100">
            <li>دادگاه‌های انقلاب</li>
            <li>اعترافات اجباری</li>
            <li>بدون هیئت منصفه</li>
            <li>محاکمات مخفی</li>
          </ul>
        </div>
        <div class="bg-green-800 text-white p-8">
          <h3 class="text-lg font-bold mb-1 text-gold-light">قانون اساسی آمریکا</h3>
          <ul class="space-y-3 mt-4 text-green-100">
            <li>حق داشتن وکیل</li>
            <li>محاکمه با هیئت منصفه</li>
            <li>بدون حکم دادگاه کسی را نمی‌توانند بازداشت کنند</li>
            <li>بی‌گناهی تا وقتی جرم ثابت نشده</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- 6. حقوق دیجیتال -->
    <div class="mb-12">
      <h2 class="text-2xl md:text-3xl font-bold text-navy mb-6 text-center">حقوق دیجیتال</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-0 rounded-xl overflow-hidden shadow-lg">
        <div class="bg-red-900 text-white p-8">
          <h3 class="text-lg font-bold mb-1 text-red-300">جمهوری اسلامی</h3>
          <ul class="space-y-3 mt-4 text-red-100">
            <li>امتیاز آزادی اینترنت: ۲ از ۱۰۰</li>
            <li>کلید قطع اینترنت</li>
            <li>وی‌پی‌ان غیرقانونی</li>
            <li>نظارت کامل</li>
          </ul>
        </div>
        <div class="bg-green-800 text-white p-8">
          <h3 class="text-lg font-bold mb-1 text-gold-light">قانون اساسی آمریکا</h3>
          <ul class="space-y-3 mt-4 text-green-100">
            <li>حریم خصوصی‌ات محفوظ است — کسی حق جاسوسی ندارد</li>
            <li>اینترنت آزاد و بدون فیلتر</li>
            <li>دولت حق سانسور ندارد</li>
          </ul>
        </div>
      </div>
    </div>

  </section>

  <!-- CTA -->
  <section class="bg-navy py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <p class="text-2xl font-bold text-white mb-6">این حقوق می‌تواند مال تو باشد.</p>
      <a
        href="/fa/the-process/"
        class="inline-block bg-gold text-navy font-bold text-lg px-8 py-4 rounded-lg hover:bg-gold-light transition-colors"
      >
        مسیر به ایالت شدن را بخوانید
      </a>
    </div>
  </section>

</BaseLayout>
