---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/HeroSection.astro';
import StatCard from '../../components/StatCard.astro';
---
<BaseLayout title="ایالت پنجاه و یکم" lang="fa">

  <!-- Section 1: Hero -->
  <HeroSection
    headline="قانون اساسی از آن شماست"
    subtitle="حقوق، آزادی و احترام — نه وعده، بلکه قانون. ۲۵۰ سال امتحانش را پس داده."
    lang="fa"
  />

  <!-- Section 2: Iran by the Numbers -->
  <section class="max-w-7xl mx-auto px-6 py-16 md:py-24">
    <h2 class="text-3xl font-bold text-navy mb-12 text-center">وضعیت ایران در یک نگاه</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <StatCard
        number="+۲,۲۲۸"
        unit="اعدام در سال ۲۰۲۵"
        description="بالاترین نرخ اعدام در جهان. دو برابر سال قبل."
        variant="navy"
      />
      <StatCard
        number="٪۴۸"
        unit="تورم"
        description="ارزش ریال ۲۰ هزار برابر کمتر شده. از هر ۳ ایرانی، بیش از ۱ نفر زیر خط فقر است."
        variant="white"
      />
      <StatCard
        number="اعدام"
        unit="مجازات ترک اسلام"
        description="آزادی مذهبی وجود ندارد. بهائی‌ها، مسیحی‌ها، سنی‌ها و زرتشتی‌ها سرکوب می‌شوند."
        variant="navy"
      />
      <StatCard
        number="۲/۱۰۰"
        unit="امتیاز آزادی اینترنت"
        description="اینترنت قطع شد. تلگرام، اینستاگرام، یوتیوب، واتساپ فیلتر هستند. استفاده از VPN جرم است."
        variant="white"
      />
      <StatCard
        number="نصف"
        unit="ارزش شهادت زن"
        description="شهادت زن نصف مرد. ارث نصف. مرد یک‌طرفه طلاق می‌دهد. بی‌حجابی تا ۱۵ سال زندان دارد."
        variant="navy"
      />
      <StatCard
        number="۶ میلیون"
        unit="خانه خالی"
        description="میلیون‌ها نفر بی‌خانمان‌اند. ۶۰٪ درآمد تهرانی‌ها خرج اجاره می‌شود."
        variant="white"
      />
    </div>
  </section>

  <!-- Section 3: What the Constitution Guarantees -->
  <section class="bg-gray-bg py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-3xl font-bold text-navy mb-8">قانون اساسی آمریکا چه چیزی به شما می‌دهد</h2>
      <ul class="space-y-4">
        <li class="flex items-start gap-3">
          <span class="text-gold text-xl mt-0.5">&#10003;</span>
          <span class="text-lg text-gray-700">هر چه می‌خواهید بگویید، بنویسید، و اعتراض کنید</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-gold text-xl mt-0.5">&#10003;</span>
          <span class="text-lg text-gray-700">هر دینی بخواهید داشته باشید — یا هیچ دینی</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-gold text-xl mt-0.5">&#10003;</span>
          <span class="text-lg text-gray-700">جدایی دین از حکومت</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-gold text-xl mt-0.5">&#10003;</span>
          <span class="text-lg text-gray-700">زبان رسمی وجود ندارد — فارسی، کردی، ترکی، بلوچی همه آزادند</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-gold text-xl mt-0.5">&#10003;</span>
          <span class="text-lg text-gray-700">قانون برای همه یکسان است — فرقی نمی‌کند کُرد باشی یا فارس، عرب باشی یا بلوچ</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-gold text-xl mt-0.5">&#10003;</span>
          <span class="text-lg text-gray-700">مرزهای ایران زیر چتر ارتش آمریکا — هیچ کشوری جرأت تجاوز ندارد</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-gold text-xl mt-0.5">&#10003;</span>
          <span class="text-lg text-gray-700">دادگاه مستقل با هیئت منصفه — نه دادگاه انقلاب</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- Section 4: Explore -->
  <section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-6">
      <h2 class="text-3xl font-bold text-navy mb-8 text-center">بیشتر بخوانید</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="/fa/your-rights/" class="border rounded-xl p-8 hover:border-gold transition-colors block">
          <h3 class="text-xl font-bold text-navy">حقوق شما</h3>
          <p class="text-gray-text mt-2">قانون اساسی آمریکا به زبان ساده</p>
        </a>
        <a href="/fa/issues-today/" class="border rounded-xl p-8 hover:border-gold transition-colors block">
          <h3 class="text-xl font-bold text-navy">مسائل امروز</h3>
          <p class="text-gray-text mt-2">بحران‌هایی که مردم ایران هر روز باهاشون دست و پنجه نرم می‌کنند</p>
        </a>
        <a href="/fa/the-process/" class="border rounded-xl p-8 hover:border-gold transition-colors block">
          <h3 class="text-xl font-bold text-navy">مسیر</h3>
          <p class="text-gray-text mt-2">چگونه ایالت شدن از نظر قانونی ممکن است</p>
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
