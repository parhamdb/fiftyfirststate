---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/HeroSection.astro';
---
<BaseLayout title="About" lang="en">

  <HeroSection
    headline="About Iran51"
    subtitle="What this campaign is and why it exists"
  />

  <section class="py-20 md:py-28">
    <div class="max-w-3xl mx-auto px-6">
      <div class="prose prose-lg max-w-none text-gray-700">
        <p class="text-xl leading-relaxed">
          Iran51 is an advocacy campaign exploring and promoting the admission of Iran as the 51st state of the United States of America.
        </p>
        <p>
          This is not satire. This is a serious policy proposal built on data, legal precedent, and the belief that the American constitutional framework offers the best path forward for both nations.
        </p>
        <p>
          We present research across economics, law, history, culture, and geopolitics. We welcome debate, criticism, and engagement. The strength of this proposal is that it withstands scrutiny — and we invite it.
        </p>
      </div>

      <div class="mt-16 bg-gradient-to-br from-navy to-navy-light rounded-2xl p-10">
        <h2 class="text-xl font-black text-gold mb-4">Contact</h2>
        <a href="mailto:info@iran51.com" class="text-white hover:text-gold-light font-bold text-lg transition-colors">info@iran51.com</a>
      </div>

      <p class="text-sm text-gray-text italic mt-10">
        Iran51 is not affiliated with any government, political party, or organization.
      </p>
    </div>
  </section>

</BaseLayout>
