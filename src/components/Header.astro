---
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: 'en' | 'fa';
}

const { lang } = Astro.props;

const navLinks = lang === 'en'
  ? [
      { label: 'Why Iran', href: '/en/why-iran/' },
      { label: 'The Process', href: '/en/the-process/' },
      { label: 'Our History', href: '/en/our-history/' },
      { label: 'Research', href: '/en/research/' },
      { label: 'About', href: '/en/about/' },
    ]
  : [
      { label: 'حقوق شما', href: '/fa/your-rights/' },
      { label: 'مسائل امروز', href: '/fa/issues-today/' },
      { label: 'مسیر', href: '/fa/the-process/' },
    ];
---

<header class="sticky top-0 bg-white border-b border-gray-200 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href={`/${lang}/`} class="text-navy font-bold text-xl tracking-wide">
        IRAN 51
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-6">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-navy hover:text-gold transition-colors text-sm font-medium"
          >
            {link.label}
          </a>
        ))}
        <LanguageSwitcher />
      </nav>

      <!-- Mobile hamburger -->
      <button
        id="menu-toggle"
        class="md:hidden p-2 text-navy"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="menu-icon-open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          <path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Mobile nav -->
    <nav id="mobile-menu" class="hidden md:hidden pb-4">
      <div class="flex flex-col gap-3">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-navy hover:text-gold transition-colors text-sm font-medium py-1"
          >
            {link.label}
          </a>
        ))}
        <div class="pt-2">
          <LanguageSwitcher />
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
