---
interface Props {
  lang: 'en' | 'fa';
}

const { lang } = Astro.props;

const copyright = lang === 'en'
  ? '2026 Iran51. All rights reserved.'
  : '۲۰۲۶ ایران۵۱. تمامی حقوق محفوظ است.';

const tagline = lang === 'en'
  ? 'An advocacy campaign exploring Iran as the 51st state of the United States of America.'
  : 'کمپین حمایتی برای بررسی پیوستن ایران به ایالات متحده آمریکا.';

const contactLabel = lang === 'en' ? 'Contact' : 'تماس';
---

<footer class="bg-navy text-white py-16 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-start justify-between gap-8">
      <div class="max-w-sm">
        <p class="flex items-center gap-2">
          <span class="text-gold text-lg">&#9733;</span>
          <span class="font-black text-xl tracking-wider">IRAN 51</span>
        </p>
        <p class="text-sm text-gray-400 mt-3 leading-relaxed">{tagline}</p>
      </div>

      <div class="text-sm">
        <p class="font-semibold text-gray-300 uppercase tracking-widest text-xs mb-2">{contactLabel}</p>
        <a href="mailto:info@iran51.com" class="text-gold hover:text-gold-light transition-colors">info@iran51.com</a>
      </div>
    </div>

    <div class="border-t border-white/10 mt-10 pt-6">
      <p class="text-xs text-gray-500">&copy; {copyright}</p>
    </div>
  </div>
</footer>
